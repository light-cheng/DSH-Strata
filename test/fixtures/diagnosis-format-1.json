{
  "about": [
    "Contract for DSH diagnosis block format 1, shared by dsh-mem0 and dsh-strata.",
    "dsh-strata copies this file and lib/diagnose-report.js verbatim; change both copies together.",
    "Each case: input -> the block diagnosisBlock writes, as lines.",
    "input.entry is a failure record, read with diagnosisFacts (message redaction is the plugin's own; the test passes it through unchanged).",
    "input.facts are standard fields given directly (status blocks). input.extra goes to the x. field area as given (object or list of pairs).",
    "A reader treats a block without kind as a failure block."
  ],
  "format": 1,
  "cases": [
    {
      "name": "failure block (Mem0)",
      "input": {
        "plugin": "dsh-mem0",
        "version": "0.4.0",
        "kind": "failure",
        "entry": {
          "at": "2026-11-27T08:15:02.123Z",
          "firstAt": "2026-11-27T08:01:00Z",
          "cause": "extraction",
          "reason": "not_json",
          "component": "llm",
          "step": "extract",
          "kind": "capture",
          "backend": "local",
          "provider": "openai_compat",
          "endpoint": "127.0.0.1:8080",
          "status": 200,
          "code": "not_json",
          "message": "model reply was not JSON",
          "durationMs": 2301.6,
          "stepElapsedMs": 2290,
          "count": 3,
          "recovered": false,
          "detail": "dropped: a gateway may echo request text here",
          "apiKey": "dropped"
        }
      },
      "expected": [
        "<dsh-diagnosis plugin=\"dsh-mem0\" version=\"0.4.0\" kind=\"failure\" format=\"1\">",
        "type: extraction/not_json",
        "component: llm",
        "step: extract",
        "operation: capture",
        "backend: local",
        "provider: openai_compat",
        "endpoint: 127.0.0.1:8080",
        "http_status: 200",
        "code: not_json",
        "message: model reply was not JSON",
        "duration_ms: 2302",
        "step_elapsed_ms: 2290",
        "count: 3",
        "first_at: 2026-11-27T08:01:00.000Z",
        "last_at: 2026-11-27T08:15:02.123Z",
        "recovered: no",
        "</dsh-diagnosis>"
      ]
    },
    {
      "name": "kind omitted: written as a failure block",
      "input": {
        "plugin": "dsh-mem0",
        "entry": {
          "at": "2026-11-27T08:15:02Z",
          "cause": "timeout",
          "component": "server",
          "kind": "recall",
          "count": 1
        }
      },
      "expected": [
        "<dsh-diagnosis plugin=\"dsh-mem0\" kind=\"failure\" format=\"1\">",
        "type: timeout",
        "component: server",
        "operation: recall",
        "count: 1",
        "last_at: 2026-11-27T08:15:02.000Z",
        "</dsh-diagnosis>"
      ]
    },
    {
      "name": "unknown kind: written as a failure block",
      "input": {
        "plugin": "dsh-mem0",
        "kind": "report",
        "entry": {
          "at": "2026-11-27T08:15:02Z",
          "cause": "auth",
          "component": "server",
          "status": 401,
          "recovered": true,
          "recoveredAt": "2026-11-27T09:00:00Z"
        }
      },
      "expected": [
        "<dsh-diagnosis plugin=\"dsh-mem0\" kind=\"failure\" format=\"1\">",
        "type: auth",
        "component: server",
        "http_status: 401",
        "count: 1",
        "last_at: 2026-11-27T08:15:02.000Z",
        "recovered: yes",
        "recovered_at: 2026-11-27T09:00:00.000Z",
        "</dsh-diagnosis>"
      ]
    },
    {
      "name": "status block with x. fields (Strata)",
      "input": {
        "plugin": "dsh-strata",
        "version": "0.3.1",
        "kind": "status",
        "facts": [],
        "extra": {
          "x.mode": "auto",
